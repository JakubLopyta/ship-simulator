{
  "scenarioId": "target_ship_passing",
  "title": "Target Ship Passing",
  "parameters": [
    { "type": "header", "label": "Own Vessel" },
    { "type": "dropdown", "id": "shipClass", "label": "Ship Class", "options": ["cargo_general", "tanker_lng"] },
    {
      "type": "row", "id": "vesselKinematics",
      "children": [
        { "type": "slider", "id": "initialSpeed", "label": "Speed (knots)", "min": 0, "max": 25, "defaultValue": 14 },
        { "type": "input", "id": "initialHeading", "label": "Heading (degrees)", "defaultText": "045.0" }
      ]
    },

    { "type": "header", "label": "Environment" },
    {
      "type": "row", "id": "envConditions",
      "children": [
        { "type": "slider", "id": "timeOfDay", "label": "Time of Day (hr)", "min": 0, "max": 23, "defaultValue": 7 },
        { "type": "dropdown", "id": "weatherPreset", "label": "Weather Preset", "options": ["Clear", "Fog", "Rain", "Thunderstorm"] }
      ]
    },

    { "type": "header", "label": "Obstacle Settings" },
    { "type": "dropdown", "id": "obstacleType", "label": "Obstacle Ship Type", "options": ["tanker_lng", "cargo_general"] },
    {
      "type": "row", "id": "obstacleKinematics",
      "children": [
        { "type": "slider", "id": "obstacleSpeed", "label": "Obstacle Speed (knots)", "min": 0, "max": 25, "defaultValue": 10.5 },
        { "type": "input", "id": "obstacleHeading", "label": "Obstacle Heading (degrees)", "defaultText": "270.0" }
      ]
    }
  ]
}
